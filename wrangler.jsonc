{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "adm1ral",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "7e273d38-d25d-4a1c-9bea-5ff0b9c7bdb7","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "2e00d09b4b6b49278e4efe952cfaab50" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
